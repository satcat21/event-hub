# Public domain of this service (no trailing slash)
DOMAIN=webhook.your-domain
APP_PORT=8080

# Must match the public URL used in browser and OIDC callback
BASE_URL=https://webhook.your-domain

# Public project repository shown on landing page
GITHUB_URL=https://github.com/satcat21/event-hub

# Session signing secret. Generate with: openssl rand -hex 32
SESSION_SECRET=replace_with_long_random_hex

# Token persistence file path inside container/host mount
TOKENS_FILE=/app/data/tokens.json

# Zitadel issuer URL (project/instance domain)
ZITADEL_ISSUER=https://login.example.com

# OAuth/OIDC client in Zitadel.
# Public + PKCE: leave ZITADEL_CLIENT_SECRET empty.
# Confidential: set ZITADEL_CLIENT_SECRET.
ZITADEL_CLIENT_ID=replace_with_zitadel_client_id
ZITADEL_CLIENT_SECRET=
